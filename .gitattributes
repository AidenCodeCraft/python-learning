# 统一换行符，避免 Windows 上 git 每次改动都报 LF/CRLF 警告
* text=auto

# 文本文件用 LF
*.py   text eol=lf
*.md   text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf

# 脚本保持 CRLF，Windows PowerShell 5.1 读起来更稳
*.ps1  text eol=crlf
*.cmd  text eol=crlf
*.bat  text eol=crlf

# 二进制，别做换行转换
*.png  binary
*.jpg  binary
*.ico  binary
*.xlsx binary
*.docx binary
